---
import BaseLayout from '../layouts/BaseLayout.astro';
import { registry } from '../lib/content-registry';
---

<BaseLayout title={`Page not found | ${registry.site.title}`} description="The requested page could not be found.">
  <section class="rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">404</p>
    <h1 class="mt-3 text-4xl font-bold text-slate-900 dark:text-white">This lesson is not here yet.</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-300">The page you requested may have moved or the content has not been published.</p>
    <a href="/docs" class="mt-6 inline-flex rounded-full bg-sky-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-sky-500">Return to docs</a>
  </section>
</BaseLayout>
