---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestLessons, registry } from '../lib/content-registry';

const latestLessons = getLatestLessons(4);
const publishedLessonCount = registry.lessons.filter((lesson) => lesson.status === 'published').length;
const recentTopicCount = registry.topics.filter((topic) => topic.status === 'published').length;
---

<BaseLayout title={`${registry.site.title} | Home`} description={registry.site.description}>
  <div class="space-y-10">
    <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
      <div class="grid gap-8 lg:grid-cols-[1.5fr_0.8fr] lg:items-end">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">Technology knowledge base</p>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Learn deeply, build confidently.</h1>
          <p class="mt-4 max-w-xl text-lg text-slate-600 dark:text-slate-300">
            A practical digital library for AI, machine learning, web engineering, developer tools, and the mathematics behind modern systems.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/docs" class="rounded-full bg-sky-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-sky-500">Browse docs</a>
            <a href="/search" class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-sky-400 hover:text-sky-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:border-sky-500 dark:hover:text-sky-300">Search content</a>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/60">
          <div class="rounded-xl bg-white p-4 shadow-sm dark:bg-slate-900">
            <div class="text-2xl font-bold text-slate-900 dark:text-white">{registry.publishedCategories.length}</div>
            <div class="text-sm text-slate-600 dark:text-slate-300">Categories</div>
          </div>
          <div class="rounded-xl bg-white p-4 shadow-sm dark:bg-slate-900">
            <div class="text-2xl font-bold text-slate-900 dark:text-white">{recentTopicCount}</div>
            <div class="text-sm text-slate-600 dark:text-slate-300">Topics</div>
          </div>
          <div class="rounded-xl bg-white p-4 shadow-sm dark:bg-slate-900">
            <div class="text-2xl font-bold text-slate-900 dark:text-white">{publishedLessonCount}</div>
            <div class="text-sm text-slate-600 dark:text-slate-300">Lessons</div>
          </div>
          <div class="rounded-xl bg-white p-4 shadow-sm dark:bg-slate-900">
            <div class="text-2xl font-bold text-slate-900 dark:text-white">{latestLessons.length}</div>
            <div class="text-sm text-slate-600 dark:text-slate-300">Updated</div>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Browse by category</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {registry.publishedCategories.map((category) => (
          <a href={`/docs/${category.slug}`} class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-sky-300 dark:border-slate-800 dark:bg-slate-900">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-sky-100 text-xl text-sky-700 dark:bg-sky-950/60 dark:text-sky-300">
              {category.icon || '•'}
            </div>
            <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{category.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{category.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Recently updated</h2>
        <a href="/docs" class="text-sm font-medium text-sky-600 hover:text-sky-500 dark:text-sky-300">View all lessons</a>
      </div>
      <div class="grid gap-4 lg:grid-cols-2">
        {latestLessons.map((lesson) => {
          const topic = registry.topics.find((entry) => entry.id === lesson.topicId);
          const category = topic ? registry.publishedCategories.find((entry) => entry.id === topic.categoryId) : undefined;
          return (
            <a href={`/docs/${category?.slug ?? 'docs'}/${topic?.slug ?? ''}/${lesson.slug}`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 dark:border-slate-800 dark:bg-slate-900">
              <div class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">{category?.title ?? 'Category'}</div>
              <h3 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">{lesson.title}</h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{lesson.description}</p>
              <div class="mt-3 text-xs text-slate-500 dark:text-slate-400">Updated {new Date(lesson.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>
