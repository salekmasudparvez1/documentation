---
import BaseLayout from "../layouts/BaseLayout.astro";
import { registry } from "../lib/content-registry";
---

<BaseLayout
  title={`Search | ${registry.site.title}`}
  description="Search the DOC_26 for lessons and topics."
>
  <section
    class="mx-auto max-w-3xl rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:rounded-3xl sm:p-6 md:p-8"
  >
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-600 dark:text-sky-400 sm:text-xs"
    >
      Search
    </p>
    <h1
      class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl md:text-4xl"
    >
      Find relevant lessons quickly.
    </h1>

    <label class="mt-5 block sm:mt-6">
      <span class="sr-only">Search the docs</span>
      <input
        id="search-input"
        type="search"
        placeholder={registry.site.search.placeholder}
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500 sm:rounded-2xl sm:px-4 sm:py-3 sm:text-base"
      />
    </label>

    <div
      id="search-results"
      class="mt-5 space-y-2.5 sm:mt-6 sm:space-y-3"
      aria-live="polite"
    >
    </div>
  </section>

  <script is:inline>
    const input = document.getElementById("search-input");
    const results = document.getElementById("search-results");

    const escapeHtml = (value) =>
      value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

    async function loadDocs() {
      const response = await fetch("/search-index.json");
      const docs = await response.json();
      return docs;
    }

    function renderResults(entries) {
      if (!entries.length) {
        results.innerHTML = `
          <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-3.5 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-400 sm:rounded-2xl sm:p-4 sm:text-sm">
            No results found for this query.
          </div>`;
        return;
      }

      results.innerHTML = entries
        .map(
          (entry) => `
          <a
            href="${entry.url}"
            class="group block rounded-xl border border-slate-200 bg-white p-3.5 shadow-sm transition hover:border-sky-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-950 sm:rounded-2xl sm:p-4"
          >
            <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-sky-600 dark:text-sky-400 sm:text-xs">
              Lesson
            </div>
            <div class="mt-1.5 text-base font-semibold text-slate-900 transition group-hover:text-sky-700 dark:text-white dark:group-hover:text-sky-300 sm:mt-2 sm:text-lg">
              ${escapeHtml(entry.title)}
            </div>
            <div class="mt-1 line-clamp-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400 sm:mt-1.5 sm:text-sm">
              ${escapeHtml(entry.description)}
            </div>
          </a>
        `,
        )
        .join("");
    }

    let docs = [];
    loadDocs().then((values) => {
      docs = values;
      renderResults(docs.slice(0, 8));
    });

    input.addEventListener("input", (event) => {
      const query = event.target.value.trim().toLowerCase();
      if (!query) {
        renderResults(docs.slice(0, 8));
        return;
      }

      const filtered = docs.filter((doc) => {
        const haystack =
          `${doc.title} ${doc.description} ${doc.content}`.toLowerCase();
        return haystack.includes(query);
      });

      renderResults(filtered.slice(0, 12));
    });
  </script>
</BaseLayout>
