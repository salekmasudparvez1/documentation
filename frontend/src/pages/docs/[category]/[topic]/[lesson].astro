---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TOC from '../../../../components/TOC.astro';
import { getCategoryBySlug, getLessonBySlug, getTopicBySlug, registry } from '../../../../lib/content-registry';
import { renderLessonSections } from '../../../../lib/renderers';

export function getStaticPaths() {
  return registry.publishedLessons.map((lesson) => {
    const topic = registry.publishedTopics.find((entry) => entry.id === lesson.topicId);
    const category = topic ? registry.publishedCategories.find((entry) => entry.id === topic.categoryId) : undefined;
    return {
      params: {
        category: category?.slug ?? 'docs',
        topic: topic?.slug ?? 'topic',
        lesson: lesson.slug,
      },
    };
  });
}

const { category: categorySlug, topic: topicSlug, lesson: lessonSlug } = Astro.params;
const category = getCategoryBySlug(categorySlug ?? '');
const topic = getTopicBySlug(categorySlug ?? '', topicSlug ?? '');
const lesson = getLessonBySlug(categorySlug ?? '', topicSlug ?? '', lessonSlug ?? '');

if (!category || !topic || !lesson) {
  throw new Error('Lesson not found');
}

const headingList = lesson.sections.flatMap((section) => {
  if (section.type !== 'markdown') return [];
  const matches = [...section.content.matchAll(/^#{1,6}\s+(.+)$/gm)];
  return matches.map((match) => {
    const title = match[1].trim();
    const slug = title.toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-');
    const level = match[0].match(/^#+/)?.[0].length ?? 2;
    return { id: slug, title, level };
  });
});

const lessonHtml = await renderLessonSections(lesson.sections);
const lessonIndex = registry.publishedLessons.filter((entry) => entry.topicId === topic.id).findIndex((entry) => entry.id === lesson.id);
const topicLessons = registry.publishedLessons.filter((entry) => entry.topicId === topic.id);
const previousLesson = lessonIndex > 0 ? topicLessons[lessonIndex - 1] : undefined;
const nextLesson = lessonIndex < topicLessons.length - 1 ? topicLessons[lessonIndex + 1] : undefined;
---

<BaseLayout title={`${lesson.title} | ${registry.site.title}`} description={lesson.description}>
  <div class="mb-6">
    <nav class="text-sm text-slate-500 dark:text-slate-400">
      <a href="/docs" class="hover:text-sky-600 dark:hover:text-sky-300">Docs</a>
      <span class="mx-2">/</span>
      <a href={`/docs/${category.slug}`} class="hover:text-sky-600 dark:hover:text-sky-300">{category.title}</a>
      <span class="mx-2">/</span>
      <a href={`/docs/${category.slug}/${topic.slug}`} class="hover:text-sky-600 dark:hover:text-sky-300">{topic.title}</a>
    </nav>
  </div>

  <div class="grid gap-8 xl:grid-cols-[220px_minmax(0,1fr)]">
    <div class="hidden xl:block">
      <TOC headings={headingList} />
    </div>

    <article class="content-surface rounded-3xl border p-6 shadow-sm sm:p-8">
      <div class="mb-8 border-b border-slate-200 pb-5 dark:border-slate-800">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">{topic.title}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 dark:text-white">{lesson.title}</h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">{lesson.description}</p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
          <span class="rounded-full bg-slate-100 px-2 py-1 dark:bg-slate-800">{lesson.level}</span>
          {lesson.estimatedReadingMinutes && <span class="rounded-full bg-slate-100 px-2 py-1 dark:bg-slate-800">{lesson.estimatedReadingMinutes} min read</span>}
          <span class="rounded-full bg-slate-100 px-2 py-1 dark:bg-slate-800">Updated {new Date(lesson.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
        </div>
      </div>

      <div set:html={lessonHtml} />

      <div class="mt-10 border-t border-slate-200 pt-6 dark:border-slate-800">
        <h2 class="mb-3 text-xl font-semibold text-slate-900 dark:text-white">Related lessons</h2>
        <div class="flex flex-wrap gap-2">
          {(lesson.relatedLessons || []).map((relatedId) => {
            const relatedLesson = registry.publishedLessons.find((candidate) => candidate.id === relatedId);
            if (!relatedLesson) return null;
            const relatedTopic = registry.publishedTopics.find((entry) => entry.id === relatedLesson.topicId);
            const relatedCategory = relatedTopic ? registry.publishedCategories.find((entry) => entry.id === relatedTopic.categoryId) : undefined;
            return (
              <a href={`/docs/${relatedCategory?.slug ?? category.slug}/${relatedTopic?.slug ?? topic.slug}/${relatedLesson.slug}`} class="content-muted rounded-full border px-3 py-2 text-sm transition hover:border-emerald-500 hover:text-emerald-700">
                {relatedLesson.title}
              </a>
            );
          })}
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-4 border-t border-slate-200 pt-6 sm:flex-row sm:justify-between dark:border-slate-800">
        {previousLesson ? (
          <a href={`/docs/${category.slug}/${topic.slug}/${previousLesson.slug}`} class="content-muted rounded-xl border px-4 py-3 text-left text-sm font-medium transition hover:border-emerald-500 hover:text-emerald-700">
            <div class="text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Previous</div>
            <div class="mt-1">{previousLesson.title}</div>
          </a>
        ) : <span />}

        {nextLesson ? (
          <a href={`/docs/${category.slug}/${topic.slug}/${nextLesson.slug}`} class="content-muted rounded-xl border px-4 py-3 text-left text-sm font-medium transition hover:border-emerald-500 hover:text-emerald-700 sm:text-right">
            <div class="text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Next</div>
            <div class="mt-1">{nextLesson.title}</div>
          </a>
        ) : <span />}
      </div>
    </article>
  </div>
</BaseLayout>
