---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCategoryBySlug, getTopicBySlug, getTopicLessons, registry } from '../../../lib/content-registry';

export function getStaticPaths() {
  return registry.publishedTopics.map((topic) => {
    const category = registry.publishedCategories.find((entry) => entry.id === topic.categoryId);
    return {
      params: {
        category: category?.slug ?? 'docs',
        topic: topic.slug,
      },
    };
  });
}

const { category: categorySlug, topic: topicSlug } = Astro.params;
const category = getCategoryBySlug(categorySlug ?? '');
const topic = getTopicBySlug(categorySlug ?? '', topicSlug ?? '');
if (!category || !topic) {
  throw new Error('Topic not found');
}

const lessons = getTopicLessons(topic.id);
---

<BaseLayout title={`${topic.title} | ${registry.site.title}`} description={topic.description}>
  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
    <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400">
      <a href="/docs" class="hover:text-sky-600 dark:hover:text-sky-300">Docs</a>
      <span class="mx-2">/</span>
      <a href={`/docs/${category.slug}`} class="hover:text-sky-600 dark:hover:text-sky-300">{category.title}</a>
    </nav>
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">Topic</p>
    <h1 class="mt-3 text-4xl font-bold text-slate-900 dark:text-white">{topic.title}</h1>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-300">{topic.description}</p>
  </section>

  <div class="mt-8 space-y-4">
    {lessons.length > 0 ? lessons.map((lesson) => (
      <a href={`/docs/${category.slug}/${topic.slug}/${lesson.slug}`} class="block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between gap-3">
          <div>
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">Lesson</div>
            <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">{lesson.title}</h2>
          </div>
          <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">{lesson.level}</span>
        </div>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{lesson.description}</p>
      </a>
    )) : <div class="rounded-2xl border border-dashed border-slate-300 p-6 text-slate-600 dark:border-slate-700 dark:text-slate-300">No published lessons in this topic yet.</div>}
  </div>
</BaseLayout>
