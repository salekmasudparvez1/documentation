---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryOverview, registry } from '../../lib/content-registry';

export function getStaticPaths() {
  return registry.publishedCategories.map((category) => ({
    params: { category: category.slug },
  }));
}

const { category } = Astro.params;
const overview = getCategoryOverview(category ?? '');
if (!overview) {
  throw new Error('Category not found');
}

const { category: categoryRecord, topics, lessons } = overview;
---

<BaseLayout title={`${categoryRecord.title} | ${registry.site.title}`} description={categoryRecord.description}>
  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">Category</p>
    <h1 class="mt-3 text-4xl font-bold text-slate-900 dark:text-white">{categoryRecord.title}</h1>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-300">{categoryRecord.description}</p>
  </section>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    {topics.length > 0 ? topics.map((topic) => (
      <a href={`/docs/${categoryRecord.slug}/${topic.slug}`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 dark:border-slate-800 dark:bg-slate-900">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-300">{topic.title}</div>
        <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">{topic.title}</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{topic.description}</p>
        <div class="mt-4 text-sm font-medium text-sky-600 dark:text-sky-300">{lessons.filter((lesson) => lesson.topicId === topic.id).length} lessons</div>
      </a>
    )) : <div class="rounded-2xl border border-dashed border-slate-300 p-6 text-slate-600 dark:border-slate-700 dark:text-slate-300">No published topics in this category yet.</div>}
  </div>
</BaseLayout>
