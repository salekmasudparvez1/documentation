---
interface Heading {
  id: string;
  title: string;
  level: number;
}

const { headings = [] } = Astro.props as { headings: Heading[] };
---
{headings.length > 0 && (
  <nav aria-label="Table of contents" class="hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:block dark:border-slate-800 dark:bg-slate-900">
    <h2 class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Contents</h2>
    <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300">
      {headings.map((heading) => (
        <li style={`margin-left: ${Math.max(0, heading.level - 2) * 0.75}rem`}>
          <a href={`#${heading.id}`} class="transition hover:text-sky-600 dark:hover:text-sky-300">
            {heading.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
