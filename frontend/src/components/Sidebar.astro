---
import { getTopicNavigation } from '../lib/content-registry';

const navigation = getTopicNavigation();
const currentPath = Astro.url.pathname;
---
<aside data-docs-sidebar class="w-full max-w-xs shrink-0 rounded-3xl border border-slate-200 bg-white p-4 shadow-lg shadow-slate-200/40 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/20 lg:w-72">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Topics</h2>
  </div>
  <nav aria-label="Documentation navigation" class="sidebar-scroll space-y-4">
    {navigation.map((category) => {
      const isCurrentCategory = currentPath.startsWith(`/docs/${category.slug}`);
      return (
        <div class="space-y-2">
          <a
            href={`/docs/${category.slug}`}
            class={`block rounded-lg px-3 py-2 text-sm font-semibold transition ${isCurrentCategory ? 'bg-sky-50 text-sky-700 dark:bg-sky-950/50 dark:text-sky-300' : 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800'}`}
          >
            {category.title}
          </a>
          <div class="space-y-1 pl-3">
            {category.topics.map((topic) => {
              const isActive = currentPath === `/docs/${category.slug}/${topic.slug}` || currentPath.startsWith(`/docs/${category.slug}/${topic.slug}/`);
              return (
                <a
                  href={`/docs/${category.slug}/${topic.slug}`}
                  class={`block rounded-lg px-3 py-2 text-sm transition ${isActive ? 'bg-slate-200 text-slate-900 dark:bg-slate-700 dark:text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}`}
                >
                  {topic.title}
                </a>
              );
            })}
          </div>
        </div>
      );
    })}
  </nav>
</aside>
