---
import { getTopicNavigation } from '../lib/content-registry';
import Icon from './Icon.astro';

const navigation = getTopicNavigation();
const currentPath = Astro.url.pathname;
---
<aside
  data-docs-sidebar
  class="docs-sidebar w-full max-w-xs shrink-0 rounded-2xl border p-2.5 shadow-sm lg:w-60"
>
  <!-- Header -->
  <div class="mb-2 flex items-center justify-between border-b px-1.5 pb-2.5" style="border-color: var(--border-subtle);">
    <div>
      <p class="text-[9px] font-bold uppercase tracking-[0.16em]" style="color: var(--accent);">
        DOC_26
      </p>
      <h2 class="mt-0.5 text-[13px] font-bold" style="color: var(--text-strong);">
        Explore topics
      </h2>
    </div>
    <span
      class="rounded-full px-1.5 py-0.5 text-[9px] font-bold"
      style="background-color: var(--accent-soft); color: var(--accent);"
    >
      Library
    </span>
  </div>

  <!-- Navigation -->
  <nav aria-label="Documentation navigation" class="sidebar-scroll space-y-2">
    <!-- Home link -->
    <a
      href="/docs"
      aria-current={currentPath === '/docs' ? 'page' : undefined}
      class:list={[
        'sidebar-home flex items-center gap-2 rounded-lg px-2.5 py-2 text-[12px] font-bold transition',
        currentPath === '/docs'
          ? 'text-white shadow-sm'
          : 'hover:text-[var(--accent)]'
      ]}
      style={currentPath === '/docs'
        ? 'background-color: var(--accent); color: var(--panel);'
        : 'color: var(--text);'}
    >
      <span aria-hidden="true">⌂</span>
      <span>Documentation home</span>
    </a>

    <!-- Categories -->
    {navigation.map((category) => {
      const isCurrentCategory = currentPath.startsWith(`/docs/${category.slug}`);
      const isExactCategory = currentPath === `/docs/${category.slug}`;

      return (
        <div class="sidebar-group" data-sidebar-group>
          <div class="sidebar-category-row flex items-center gap-0.5">
            <a
              href={`/docs/${category.slug}`}
              aria-current={isExactCategory ? 'page' : undefined}
              class:list={[
                'sidebar-category flex min-w-0 flex-1 items-center gap-1.5 rounded-lg px-2.5 py-2 text-[12px] font-bold transition',
                isCurrentCategory
                  ? ''
                  : 'hover:bg-[var(--panel-hover)]'
              ]}
              style={isCurrentCategory
                ? 'background-color: var(--accent-soft); color: var(--accent);'
                : 'color: var(--text);'}
            >
              <span
                class="sidebar-category-icon inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-md"
                style="background-color: var(--panel-muted);"
              >
                <Icon name={category.icon} size={13} />
              </span>
              <span class="min-w-0 flex-1 truncate">{category.title}</span>
              <span class="text-[9px] font-semibold" style="color: var(--muted-soft);">
                {category.topics.length}
              </span>
            </a>

            <!-- Group toggle -->
            <button
              type="button"
              class="sidebar-group-toggle"
              data-sidebar-group-toggle
              aria-expanded={isCurrentCategory ? 'true' : 'false'}
              aria-label={`${isCurrentCategory ? 'Collapse' : 'Expand'} ${category.title}`}
            >
              <span aria-hidden="true">{isCurrentCategory ? '⌃' : '⌄'}</span>
            </button>
          </div>

          <!-- Topics -->
          <div
            class:list={[
              'sidebar-topics ml-2.5 mt-0.5 space-y-0.5 border-l pl-1.5',
              isCurrentCategory ? '' : 'is-collapsed'
            ]}
            style="border-color: var(--border);"
            data-sidebar-group-content
          >
            {category.topics.map((topic) => {
              const isActive =
                currentPath === `/docs/${category.slug}/${topic.slug}` ||
                currentPath.startsWith(`/docs/${category.slug}/${topic.slug}/`);

              return (
                <a
                  href={`/docs/${category.slug}/${topic.slug}`}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'sidebar-topic relative block rounded-md px-2.5 py-1.5 text-[11px] leading-4 transition',
                    isActive
                      ? 'font-semibold text-white shadow-sm'
                      : 'hover:bg-[var(--panel-hover)]'
                  ]}
                  style={isActive
                    ? 'background-color: var(--accent); color: var(--panel);'
                    : 'color: var(--muted);'}
                >
                  <span class="flex items-center gap-2">
                    <Icon name={topic.icon} size={12} class="shrink-0 opacity-75" />
                    <span class="truncate">{topic.title}</span>
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      );
    })}
  </nav>
</aside>