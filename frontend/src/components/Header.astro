---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  class="site-header sticky top-0 z-40 border-b border-emerald-950/20 bg-emerald-800 text-white shadow-lg shadow-emerald-950/10"
>
  <div
    class="mx-auto flex max-w-7xl items-center gap-2 px-3 py-1.5 sm:px-5 lg:px-8"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-2"
      aria-label="DOC_26 home page"
    >
      <span
        class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-white text-[11px] font-black tracking-tight text-emerald-800 shadow-sm"
        >D26</span
      >
      <div>
        <div class="text-[15px] font-black leading-none tracking-tight">
          DOC_26
        </div>
        <div
          class="hidden text-[8px] font-medium uppercase tracking-[0.18em] text-emerald-100 sm:block"
        >
          Learn. Build. Ship.
        </div>
      </div>
    </a>

    <form
      action="/search"
      class="mx-auto hidden min-w-0 max-w-xl flex-1 md:flex"
      role="search"
    >
      <label class="sr-only" for="header-search">Search DOC_26</label>
      <input
        id="header-search"
        name="q"
        type="search"
        placeholder="Search topics, lessons and concepts..."
        class="w-full rounded-l-lg border-0 bg-white px-3 py-1.5 text-sm text-slate-900 outline-none ring-0 placeholder:text-slate-400 focus:ring-2 focus:ring-lime-300"
      />
      <button
        type="submit"
        class="rounded-r-lg bg-lime-400 px-3 font-bold text-emerald-950 transition hover:bg-lime-300"
        aria-label="Search">⌕</button
      >
    </form>

    <nav class="hidden items-center gap-5 lg:flex" aria-label="Main navigation">
      <a
        href="/docs"
        class="text-sm font-semibold text-emerald-50 transition hover:text-lime-300"
        >Docs</a
      >
      <a
        href="/about"
        class="text-sm font-semibold text-emerald-50 transition hover:text-lime-300"
        >About</a
      >
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href="/search"
        class="inline-flex items-center gap-2 rounded-lg border border-emerald-600 bg-emerald-700 px-2 py-1 text-sm font-semibold text-white transition hover:border-lime-300 hover:text-lime-200 md:hidden"
      >
        ⌕ <span class="hidden xs:inline">Search</span>
      </a>
      <ThemeToggle />
    </div>
  </div>
  <div class="header-mobile-search px-3 pb-2 md:hidden">
    <form action="/search" class="flex" role="search">
      <label class="sr-only" for="mobile-search">Search DOC_26</label>
      <input
        id="mobile-search"
        name="q"
        type="search"
        placeholder="Search DOC_26..."
        class="min-w-0 flex-1 rounded-l-lg border-0 bg-white px-3 py-1.5 text-sm text-slate-900 outline-none placeholder:text-slate-400"
      />
      <button
        type="submit"
        class="rounded-r-lg bg-lime-400 px-3 text-sm font-bold text-emerald-950"
        >Search</button
      >
    </form>
  </div>
</header>
