---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { registry } from '../lib/content-registry';

const { site } = registry;
const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--text)] antialiased">
    <Header />
    <div class="mobile-sidebar-shell mx-auto block max-w-6xl px-3 pt-3 sm:px-5 lg:hidden lg:px-6">
      <button
        type="button"
        class="mobile-sidebar-toggle inline-flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-semibold text-slate-800 shadow-sm transition hover:border-sky-400 hover:text-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500/50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-sky-500 dark:hover:text-sky-300"
        aria-expanded="false"
        aria-controls="mobile-sidebar-panel"
      >
        <span class="flex items-center gap-3">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300" aria-hidden="true">☰</span>
          <span>Browse topics</span>
        </span>
        <span class="mobile-sidebar-chevron text-lg transition-transform" aria-hidden="true">⌄</span>
      </button>
      <div id="mobile-sidebar-panel" class="mobile-sidebar-panel" hidden>
        <div class="mobile-sidebar-backdrop" data-sidebar-close></div>
        <div class="mobile-sidebar-drawer">
          <div class="mb-3 flex items-center justify-between px-1">
            <span class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Documentation</span>
            <button type="button" class="rounded-full p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-white" data-sidebar-close aria-label="Close topics menu">✕</button>
          </div>
          <Sidebar />
        </div>
      </div>
    </div>
    <div class="docs-frame mx-auto flex max-w-6xl gap-5 px-3 py-5 sm:px-5 lg:px-6 lg:py-6">
      <div class="desktop-sidebar-shell hidden w-60 shrink-0 lg:block">
        <button
          type="button"
          class="sidebar-collapse-button"
          aria-expanded="true"
          aria-controls="desktop-sidebar-content"
          title="Collapse navigation"
        >
          <span aria-hidden="true">‹</span>
          <span class="sr-only">Collapse navigation</span>
        </button>
        <div id="desktop-sidebar-content">
          <Sidebar />
        </div>
      </div>
      <main class="min-w-0 flex-1">
        <slot />
      </main>
    </div>
    <footer class="border-t border-slate-200 bg-white/80 py-6 text-center text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-950/80 dark:text-slate-300">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">{site.footer.copyright}</div>
    </footer>

    <script is:inline>
      const mobileSidebarToggle = document.querySelector('.mobile-sidebar-toggle');
      const mobileSidebarPanel = document.querySelector('#mobile-sidebar-panel');
      const mobileSidebarChevron = document.querySelector('.mobile-sidebar-chevron');
      const desktopSidebarShell = document.querySelector('.desktop-sidebar-shell');
      const desktopSidebarToggle = document.querySelector('.sidebar-collapse-button');
      const desktopSidebarContent = document.querySelector('#desktop-sidebar-content');

      const setDesktopSidebar = (collapsed) => {
        if (!desktopSidebarShell || !desktopSidebarToggle || !desktopSidebarContent) return;
        desktopSidebarShell.classList.toggle('is-collapsed', collapsed);
        desktopSidebarToggle.setAttribute('aria-expanded', String(!collapsed));
        desktopSidebarToggle.title = collapsed ? 'Expand navigation' : 'Collapse navigation';
        desktopSidebarToggle.querySelector('span[aria-hidden="true"]').textContent = collapsed ? '›' : '‹';
        desktopSidebarContent.setAttribute('aria-hidden', String(collapsed));
        localStorage.setItem('desktop-sidebar-collapsed', String(collapsed));
      };

      setDesktopSidebar(localStorage.getItem('desktop-sidebar-collapsed') === 'true');
      desktopSidebarToggle?.addEventListener('click', () => {
        setDesktopSidebar(!desktopSidebarShell.classList.contains('is-collapsed'));
      });

      document.querySelectorAll('[data-sidebar-group-toggle]').forEach((toggle) => {
        toggle.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const group = toggle.closest('[data-sidebar-group]');
          const content = group?.querySelector('[data-sidebar-group-content]');
          if (!content) return;
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!expanded));
          toggle.setAttribute('aria-label', `${expanded ? 'Expand' : 'Collapse'} category`);
          toggle.querySelector('span[aria-hidden="true"]').textContent = expanded ? '⌄' : '⌃';
          content.classList.toggle('is-collapsed', expanded);
        });
      });

      const setMobileSidebar = (open) => {
        if (!mobileSidebarToggle || !mobileSidebarPanel) return;
        mobileSidebarToggle.setAttribute('aria-expanded', String(open));
        mobileSidebarPanel.hidden = !open;
        mobileSidebarChevron?.classList.toggle('rotate-180', open);
        document.body.classList.toggle('sidebar-open', open);
      };

      mobileSidebarToggle?.addEventListener('click', () => {
        setMobileSidebar(mobileSidebarToggle.getAttribute('aria-expanded') !== 'true');
      });
      mobileSidebarPanel?.addEventListener('click', (event) => {
        if (event.target.closest('[data-sidebar-close]')) setMobileSidebar(false);
        if (event.target.closest('a')) setMobileSidebar(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMobileSidebar(false);
      });
      window.addEventListener('resize', () => {
        if (window.matchMedia('(min-width: 1024px)').matches) setMobileSidebar(false);
      });

      document.addEventListener('click', async (event) => {
        const trigger = event.target.closest('[data-copy-target]');
        if (!trigger) return;
        const block = document.querySelector(`[data-code-block="${trigger.dataset.copyTarget}"]`);
        if (!block) return;
        const text = block.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          const original = trigger.textContent;
          trigger.textContent = 'Copied';
          setTimeout(() => {
            trigger.textContent = original;
          }, 1200);
        } catch (error) {
          trigger.textContent = 'Error';
        }
      });
    </script>
  </body>
</html>
